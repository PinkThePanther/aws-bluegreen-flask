{
  "family": "bluegreen-flask",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::973940554982:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "bluegreen-flask",
      "image": "973940554982.dkr.ecr.us-east-1.amazonaws.com/bluegreen-flask:2f3aa1c",
      "essential": true,
      "environment": [
        {
          "name": "DEMO_MODE",
          "value": "true"
        }
      ],
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=5)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bluegreen-flask",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
