# OpenTelemetry service identity
OTEL_SERVICE_NAME=bluegreen-flask
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=2000

# Set this to send spans to an OTLP/HTTP collector or backend.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=authorization=your-token

# Optional off switch
# OTEL_SDK_DISABLED=true

# Portfolio demo account. Keep disabled outside disposable demo environments.
# When enabled, the backend creates or refreshes a non-privileged sample user.
DEMO_MODE=false

# Production hosts can mount persistent storage and point SQLite at it.
# Example for a volume mounted at /data:
# DATABASE_URL=sqlite:////data/bluegreen.db
