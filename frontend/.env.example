# Blue is the stable release and does not render the weather widget.
VITE_DEPLOYMENT_COLOR=blue

# Leave empty when Flask serves the production frontend from the same origin.
# Local Vite development can point at the separately running Flask API.
VITE_API_URL=http://127.0.0.1:8080

# Build or run the green release with:
# VITE_DEPLOYMENT_COLOR=green npm run dev
